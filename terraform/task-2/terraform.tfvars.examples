aws_config = {
    profile = ""
    region = ""
}

app_name = ""
env_name = ""

vpc_cidr=""
public_subnets = {
    a = { cidr_block = "", az = ""}
    b = { cidr_block = "", az = ""}
}

private_subnets = {
    a = { cidr_block = "", az = ""}
    b = { cidr_block = "", az = ""}
}
aws_key_pair_name = ""

user_data = <<-EOF
#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
exec > >(tee -a /var/log/user-data.log | logger -t user-data) 2>&1

apt-get update -y
apt-get upgrade -y

apt-get install -y \
    ca-certificates \
    gnupg \
    curl \
    python3-pip \
    python3.10-venv \
    git

curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs
npm install -g pm2 --unsafe-perm

node --version
npm --version 
python3 --version
EOF
