pipeline{
    agent any
    environment {
        REPO_URL = "https://github.com/sanjay2028/ubuntu-tude-tude.git"
        TARGET_BRANCH = "jenkins"
        PROJECT_HOME = "/home/ubuntu"
        BACKEND_DIR =   "/home/ubuntu/backend"
        FRONTEND_DIR = "home/ubuntu/frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: env.REPO_URL,
                    branch: env.TARGET_BRANCH
                )
                sh "sudo cp -r ./aws-assignment $PROJECT_HOME"
            }
        }

    }
}