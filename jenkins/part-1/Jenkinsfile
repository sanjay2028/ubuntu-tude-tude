pipeline {
    agent any 
    environment {
        APP_HOME = "/opt/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }
        }

        stage("BACKEND"){
            steps {
                sh """
                    cd "${APP_HOME}/${BACKEND_DIR}"
                    cp -r "${WORKSPACE}/aws-assignment/${BACKEND_DIR}/"* .
                    echo "Restart the service"
                    sudo systemctl restart flaskapp                  
                """
            }
        }

        stage("FRONTEND"){
            steps {
                sh """
                    cd "${APP_HOME}/${FRONTEND_DIR}"
                    cp -r "${WORKSPACE}/aws-assignment/${FRONTEND_DIR}/"* .
                    npm run install
                    node index.js
                """
            }
        }        
    }
}