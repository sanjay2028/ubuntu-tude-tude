pipeline{
    agent any
    environment {
        REPO_URL = "https://github.com/sanjay2028/ubuntu-tude-tude.git"
        TARGET_BRANCH = "jenkins"
        PROJECT_HOME = "/home/ubuntu/app"
        BACKEND_DIR =   "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: env.REPO_URL,
                    branch: env.TARGET_BRANCH
                )
            }
        }

        stage("Backend"){
            steps {
                sh """
                    cp -r $WORKSPACE/aws-assignment/backend $PROJECT_HOME/$BACKEND_DIR
                    pip install -r $PROJECT_HOME/$BACKEND_DIR/requirements.txt
                    pkill -f app.py || true
                    nohup python $PROJECT_HOME/$BACKEND_DIR/app.py > $PROJECT_HOME/$BACKEND_DIR/app.log 2>&1 &
                """
            }
        }

    }
}