pipeline {
    agent any 
    environment {
        APP_HOME = "/home/ubuntu/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                sh """
                    echo "Kill the existing process"
                    pkill -f $APP_HOME/$BACKEND/app.py

                    echo "Copy the data from WORKDIR to Backend"
                    cp -r $WORKDIR/ubuntu-tute-dude/aws-assignment/backend/* $APP_HOME/$BACKEND_DIR
                    
                    echo "Install dependencies"
                    $APP_HOME/$BACKEND/venv/bin/pip install -r requirements.txt
                    
                    echo "Start the process"
                    nohup $APP_HOME/$BACKEND/venv/bin/python app.py > app.log 2>&1 &
                    
                    echo "Backend Started successfully"
                """
            }

        }



    }



}