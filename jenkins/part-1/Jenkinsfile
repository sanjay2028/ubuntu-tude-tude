pipeline {
    agent any 
    environment {
        APP_HOME = "/home/ubuntu/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }
        }

        stage("Backend"){
            steps {
                echo "Backend Process starts"
                sh """
                    set -e
                    exec 2>&1 

                    export PM2_HOME=$APP_HOME/.pm2
                    mkdir -p \$PM2_HOME

                    echo "Kill the existing process"
                    pm2 delete $BACKEND_DIR || true

                    echo "Copy the data from WORKDIR to Backend"
                    rsync -av "$WORKSPACE/aws-assignment/backend/" "$APP_HOME/$BACKEND_DIR"

                    echo "Swich to Backend Directory"
                    cd "$APP_HOME/$BACKEND_DIR"

                    echo "Verify current directory"
                    pwd 

                    echo "Install dependencies"
                    "./venv/bin/pip" install -r requirements.txt

                    pm2 start "$APP_HOME/$BACKEND_DIR/app.py" \
                        --name "$BACKEND_DIR" \
                        --cwd "$APP_HOME/$BACKEND_DIR" \
                        --env-file "$APP_HOME/$BACKEND_DIR/.env"
                        --output "$APP_HOME/$BACKEND_DIR/app.out.log" \
                        --error "$APP_HOME/$BACKEND_DIR/app.error.log" \
                        --interpreter "$APP_HOME/$BACKEND_DIR/venv/bin/python" 
                    
                    pm2 save
                    
                    echo "Backend Started successfully"
                """
            }

        }



    }



}