pipeline{
    agent any
    environment {
        REPO_URL = "https://github.com/sanjay2028/ubuntu-tude-tude.git"
        TARGET_BRANCH = "jenkins"
    }

    stages{
        stage("Checkout"){
            step {
                git(
                    url: env.REPO_URL,
                    branch: env.TARGET_BRANCH
                )
            }
        }
    }
}