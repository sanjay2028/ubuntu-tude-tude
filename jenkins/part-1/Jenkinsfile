pipeline {
    agent any 
    environment {
        APP_HOME = "/home/ubuntu/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }

        }

        stage("Backend"){
            steps {
                echo "Backend Process starts"
                sh """
                    echo "Kill the existing process"
                    
                    
                    echo "Backend Started successfully"
                """
            }

        }



    }



}