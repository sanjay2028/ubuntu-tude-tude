pipeline {
    agent any 
    environment {
        APP_HOME = "/opt/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }
        }

        stage("VENV Setup"){
            steps {
                sh """
                    echo "Switch to working dir"                    
                """
            }
        }

        stage("Backend") {
            steps {
                sh """                    
                    cd "${APP_HOME}/${BACKEND_DIR}"

                    . venv/bin/activate
                    pip install -r requirements.txt > output.txt
                    /usr/bin/nohup /opt/app/backend/venv/bin/python app.py --no-reload > backendapp.log 2>&1 &
                """
            }
        }
    }



}