pipeline {
    agent any 
    environment {
        APP_HOME = "/home/ubuntu/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }
        }

        stage("Backend"){
            steps {
                echo "Backend Process starts"
                sh """
                    echo "Kill the existing process"
                    pm2 stop $BACKEND_DIR || true

                    echo "Copy the data from WORKDIR to Backend"
                    rsync -av "$WORKSPACE/aws-assignment/backend/" "$APP_HOME/$BACKEND_DIR"

                    echo "Swich to Backend Directory"
                    cd "$APP_HOME/$BACKEND_DIR"

                    echo "Verify current directory"
                    pwd 

                    echo "Install dependencies"
                    "./venv/bin/pip" install -r requirements.txt

                    pm2 start app.py \
                        --name "$BACKEND_DIR" \
                        --output "./app.out.log" \
                        --error "./app.error.log" \
                        --interpreter = "./venv/bin/python" 

                    echo "Backend Started successfully"
                """
            }

        }



    }



}