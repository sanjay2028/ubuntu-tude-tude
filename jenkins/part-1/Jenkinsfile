pipeline {
    agent any 
    environment {
        APP_HOME = "/home/ubuntu/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }
        }

        stage("Virtual Env"){
            steps {
                sh """
                    echo "Switch to working dir"
                    cd /home/ec2-user/app/backend
                                        
                    python3 -m venv venv

                    . venv/bin/activate

                    deactivate
                """
            }
        }

        stage("Backend") {
            steps {
                sh """
                    cd /home/ec2-user/app/backend
                    echo "Copy data from workspace to backend"
                    ls -la ${WORKSPACE} > content.txt
                    cp -r ${WORKSPACE}/aws-assignment/backend/* .
                    . venv/bin/activate
                    pip3 install -r requirements.txt
                    nohup python3 app.py > app.log 2>&1 &
                """

            }
        }
    }



}