pipeline {
    agent any 
    environment {
        APP_HOME = "/home/ubuntu/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }
        }

        stage("Virtual Env"){
            steps {
                sh """
                    echo "Switch to working dir"
                    cd /home/ec2-user/app/backend
                                        
                    python3 -m venv venv

                    . venv/bin/activate

                    deactivate
                """
            }
        }

        stage("Backend") {
            steps {
                sh """
                    set -e
                    exec > >(tee -a error-logs.log | logger -t app-dep) 2>&1 
                    cd /home/ec2-user/app/backend
                    echo "Copy data from workspace to backend"
                    cp -r ${WORKSPACE}/aws-assignment/backend/* .
                    . venv/bin/activate
                    pip3 install -r requirements.txt
                    nohup python app.py > backend.log 2>&1 &
                """

            }
        }
    }



}