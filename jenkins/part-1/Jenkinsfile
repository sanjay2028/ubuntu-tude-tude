pipeline {
    agent any
    stages {
        stage("Clone") {
            steps {
                echo "clone Repository"
                sh "git clone https://github.com/sanjay2028/ubuntu-tude-tude.git"
                echo "Checkout to Jenkins branch"
                sh "git checkout -- jenkins"
                sh "git pull"                
            }
            
        }
        stage("Backend") {
            steps {
                echo "completed"
            }            
        }

        stage("Frontend") {
            steps {
                echo "completed"
            }            
        }

        stage("Notifications") {
            steps {
                echo "Email sent"
            }            
        }

    }
}