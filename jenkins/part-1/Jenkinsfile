pipeline {
    agent any 
    environment {
        APP_HOME = "/opt/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }
        }

        stage("VENV Setup"){
            steps {
                sh """
                    echo "Switch to working dir"
                    cd "${APP_HOME}/${BACKEND_DIR}"                                        
                    python3 -m venv venv

                    source venv/bin/activate
                    deactivate
                    
                """
            }
        }

        stage("Backend") {
            steps {
                sh """
                    cd "${APP_HOME}/${BACKEND_DIR}"
                    echo "Copy data from workspace to backend"
                    cp -r ${WORKSPACE}/aws-assignment/backend/* .
                    source venv/bin/activate
                    pip3 install -r requirements.txt
                    nohup venv/bin/python3 app.py > backendapp.log 2>&1 &
                """
            }
        }
    }



}