pipeline {
    agent any 
    environment {
        APP_HOME = "/opt/app"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    stages{
        stage("Checkout"){
            steps {
                git(
                    url: "https://github.com/sanjay2028/ubuntu-tude-tude/",
                    branch: "jenkins"
                )
            }
        }

        stage("VENV Setup"){
            steps {
                sh """
                    echo "Switch to working dir"                    
                """
            }
        }

        stage("Backend") {
            steps {
                sh """
                    #!/bin/bash                    
                    cd "${APP_HOME}/${BACKEND_DIR}"       
                    source venv/bin/activate
                    pip install -r requirements.txt > outputx.txt
                    nohup python app.py > backendapp.log 2>&1 &
                """
            }
        }
    }



}